#!/usr/bin/env node
// Socrates CLI — the automation surface.
//
// The skill is the interactive surface; this is what the skill, cron jobs and
// scripts actually call. Keep it boring and scriptable.
//
// STUB: taste (personalization) and moments (capture) exist so far. Session
// ingestion, packet generation and `doctor` belong here too once the engine lands.

import { createInterface } from "node:readline";
import { listCards, recordCard, reviewCard } from "../lib/card.mjs";
import {
  downloadMoodAsset,
  listMoods,
  normalizeMood,
  recordMood,
  setMoodStatus,
} from "../lib/mood.mjs";
import { renderAll, renderMoodBoardTo, renderOne } from "../lib/render.mjs";
import {
  appendJsonl,
  ensureDirs,
  paths,
  readJsonl,
  readLatestById,
  resolveHome,
  writeAtomic,
} from "../lib/store.mjs";
import { normalizeMoment } from "../lib/model.mjs";
import { compile, recordFeedback } from "../lib/taste.mjs";
import { capture, piSessionsDir } from "../lib/capture.mjs";
import { listSessions, pickSession, renderDigest } from "../lib/digest.mjs";

function parseArgs(argv) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < argv.length; i += 1) {
    const token = argv[i];
    if (token.startsWith("--")) {
      const [name, inline] = token.slice(2).split("=");
      if (inline !== undefined) {
        flags[name] = inline;
      } else if (argv[i + 1] && !argv[i + 1].startsWith("--")) {
        flags[name] = argv[i + 1];
        i += 1;
      } else {
        flags[name] = true;
      }
    } else {
      positional.push(token);
    }
  }
  return { flags, positional };
}

async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8").trim();
}

function out(value, asJson) {
  if (asJson) {
    process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
    return;
  }
  process.stdout.write(
    typeof value === "string" ? `${value}\n` : `${JSON.stringify(value, null, 2)}\n`,
  );
}

function fail(message) {
  process.stderr.write(`socrates: ${message}\n`);
  process.exit(1);
}

/**
 * An empty list is indistinguishable from reading the wrong store, so name the
 * store. Goes to stderr so `--format json` output stays pipeable.
 *
 * This exists because an exported SOCRATES_HOME silently wins over ~/.socrates,
 * and `[]` from a scratch directory looks exactly like "nothing recorded yet".
 */
function noteEmpty(what, file) {
  process.stderr.write(`socrates: 0 ${what} in ${file}\n`);
  const override = process.env.SOCRATES_HOME?.trim();
  if (override) {
    process.stderr.write(`socrates: SOCRATES_HOME=${override} overrides the default root\n`);
  }
}

async function readPayload(flags, what) {
  const raw = typeof flags.json === "string" ? flags.json : await readStdin();
  if (!raw) fail(`${what} expects a JSON object on stdin or via --json`);
  try {
    return JSON.parse(raw);
  } catch (error) {
    fail(`could not parse JSON input: ${error.message}`);
  }
}

async function tasteAdd(flags) {
  const payload = await readPayload(flags, "taste add");
  if (process.env.PI_PROVIDER) payload.harness = payload.harness ?? "pi";

  const home = resolveHome();
  ensureDirs(home);
  try {
    return recordFeedback(payload, home);
  } catch (error) {
    fail(error.message);
  }
}

async function cardAdd(flags) {
  const payload = await readPayload(flags, "card add");
  const home = resolveHome();
  ensureDirs(home);

  // Fill in what the agent should never have to guess.
  const provenance = payload.provenance ?? {};
  provenance.cwd = provenance.cwd ?? process.cwd();
  if (process.env.PI_PROVIDER) provenance.harness = provenance.harness ?? "pi";
  if (process.env.PI_MODEL) provenance.model = provenance.model ?? process.env.PI_MODEL;
  if (process.env.PI_SESSION_ID) provenance.sessionId = provenance.sessionId ?? process.env.PI_SESSION_ID;
  payload.provenance = provenance;

  let card;
  try {
    card = recordCard(payload, home);
  } catch (error) {
    fail(error.message);
  }

  const file = flags["no-render"] ? undefined : renderOne(card.id, home);
  return { card, file };
}

function cardList(flags) {
  let cards = listCards(resolveHome());
  if (flags.status) cards = cards.filter((c) => c.review.status === flags.status);
  if (flags.topic) cards = cards.filter((c) => c.topic === flags.topic);
  if (flags.tag) cards = cards.filter((c) => c.tags.includes(flags.tag));
  return cards.sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1));
}

async function moodAdd(flags) {
  const payload = await readPayload(flags, "mood add");
  const home = resolveHome();
  ensureDirs(home);

  let mood;
  try {
    mood = normalizeMood(payload);
  } catch (error) {
    fail(error.message);
  }

  // Downloading is best effort: a dead link must not lose the reference.
  let download = { downloaded: false, reason: "skipped" };
  if (!flags["no-download"]) {
    download = await downloadMoodAsset(mood, home);
    mood = download.mood;
  }

  recordMood(mood, home);
  return { mood, downloaded: download.downloaded, reason: download.reason };
}

function moodBoard(flags) {
  const home = resolveHome();
  ensureDirs(home);
  return { wrote: renderMoodBoardTo(home), items: listMoods(home).length };
}

function tasteList(flags) {
  const home = resolveHome();
  let statements = readLatestById(paths(home).statements);
  if (flags.status) statements = statements.filter((s) => s.status === flags.status);
  if (flags.level) statements = statements.filter((s) => s.scope.level === flags.level);
  if (flags.tag) statements = statements.filter((s) => s.tags?.includes(flags.tag));
  return statements.sort((a, b) => b.confidence - a.confidence);
}

function tasteCompile() {
  const home = resolveHome();
  ensureDirs(home);
  const statements = readLatestById(paths(home).statements);
  const markdown = compile(statements);
  writeAtomic(paths(home).compiled, markdown);
  return { wrote: paths(home).compiled, statements: statements.length };
}

function tasteRetire(id) {
  if (!id) fail("taste retire needs a statement id");
  const home = resolveHome();
  const statements = readLatestById(paths(home).statements);
  const statement = statements.find((s) => s.id === id);
  if (!statement) fail(`no statement with id ${id}`);
  const retired = { ...statement, status: "retired", updatedAt: new Date().toISOString() };
  appendJsonl(paths(home).statements, retired);
  return retired;
}

async function momentsAdd(flags) {
  const raw = typeof flags.json === "string" ? flags.json : await readStdin();
  if (!raw) fail("moments add expects a JSON object on stdin or via --json");

  let payload;
  try {
    payload = JSON.parse(raw);
  } catch (error) {
    fail(`could not parse JSON input: ${error.message}`);
  }

  // When the CLI is called from a Pi session (the skill shells out), the harness
  // exports these. Fill in provenance once, here, rather than trusting the caller.
  if (process.env.PI_SESSION_ID) {
    payload.origin = {
      sessionId: process.env.PI_SESSION_ID,
      harness: "pi",
      cwd: process.cwd(),
      ...payload.origin,
    };
    payload.capturedBy = { harness: "pi", model: process.env.PI_MODEL, ...payload.capturedBy };
  }
  payload.capturedBy = { by: "cli", ...payload.capturedBy };

  const home = resolveHome();
  ensureDirs(home);
  let moment;
  try {
    moment = normalizeMoment(payload);
  } catch (error) {
    fail(error.message);
  }
  appendJsonl(paths(home).moments, moment);
  return moment;
}

function momentsList(flags) {
  const home = resolveHome();
  let moments = readLatestById(paths(home).moments);
  if (flags.session) moments = moments.filter((m) => m.origin?.sessionId?.startsWith(flags.session));
  if (flags.kind) moments = moments.filter((m) => m.kind === flags.kind);
  if (flags.status) moments = moments.filter((m) => m.status === flags.status);
  return moments
    .sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)))
    .slice(0, Number(flags.limit) || 20);
}

/** Append-only correction: same id, new status, latest record wins. */
function momentsDismiss(id) {  if (!id) fail("moments dismiss needs a moment id");
  const home = resolveHome();
  const moment = readLatestById(paths(home).moments).find((m) => m.id === id);
  if (!moment) fail(`no moment with id ${id}`);
  const dismissed = { ...moment, status: "rejected", updatedAt: new Date().toISOString() };
  appendJsonl(paths(home).moments, dismissed);
  return dismissed;
}

function captureEvents(flags, asJson) {
  const home = resolveHome();
  ensureDirs(home);
  const dir = typeof flags.dir === "string" ? flags.dir : piSessionsDir();

  const result = capture({
    dir,
    eventsFile: paths(home).events,
    dryRun: flags["dry-run"] === true,
  });

  if (asJson) {
    out(result, true);
    return result;
  }

  const verb = flags["dry-run"] === true ? "would capture" : "captured";
  const lines = [
    `${verb} ${result.events} events from ${result.sessions} sessions`,
    `  from ${result.dir}`,
    `  to   ${result.eventsFile}`,
  ];
  for (const file of result.files) {
    const name = file.file.slice(result.dir.length + 1);
    lines.push(`    ${String(file.events).padStart(5)}  ${name}`);
  }
  if (!result.sessions) lines.push("    (no sessions found — is this the right --dir?)");
  out(lines.join("\n"), false);
  return result;
}

function extract(flags) {
  const home = resolveHome();
  const events = readJsonl(paths(home).events);
  if (!events.length) fail("no events yet — run `socrates capture` first");

  if (flags.list === true) {
    return listSessions(events).map(({ events: _events, ...rest }) => rest);
  }

  const selector = typeof flags.session === "string" ? flags.session : "latest";
  const picked = pickSession(events, selector);
  if (!picked) fail(`no session matching \`${selector}\` — try --list`);

  // A session with no conversation at all is not worth a model call. Say so
  // rather than emitting a digest with nothing in it.
  if (!picked.hasConversation) {
    return {
      session: picked.session,
      skipped: "no conversation — no assistant messages or tool calls",
      digest: null,
    };
  }

  return { ...picked, digest: renderDigest(picked.events) };
}

async function main() {
  // Groups are either `<group> <command>` (taste add) or flat `<group> --flags`
  // (capture). The second token is only a command if it is not a flag.
  const [group, ...tail] = process.argv.slice(2);
  const hasCommand = Boolean(tail[0]) && !tail[0].startsWith("--");
  const command = hasCommand ? tail[0] : null;
  const { flags, positional } = parseArgs(hasCommand ? tail.slice(1) : tail);
  const home = resolveHome();
  // NOTE: for `taste add`, --json is the *input* payload. Output format is
  // controlled separately so the two never get tangled.
  const asJson = flags.format === "json" || process.env.SOCRATES_FORMAT === "json";

  if (!group || group === "help" || flags.help) {
    out(
      [
        "socrates — learn from the work you already did",
        "",
        "  socrates home                        print the resolved data root",
        "",
        "  socrates capture [--dir PATH] [--dry-run]  rebuild events.jsonl from Pi sessions",
        "  socrates extract [--session ID] [--list]  print a session as a digest",
        "",
        "  socrates taste add [--json '<json>']     record preference feedback (or stdin)",
        "  socrates taste list [--status --level --tag]",
        "  socrates taste compile                   regenerate TASTE.md",
        "  socrates taste retire <id>               retire a statement",
        "",
        "  socrates moments add [--json '<json>']   record a learning moment (or stdin)",
        "  socrates moments list [--session --kind --status --limit]",
        "  socrates moments dismiss <id>            append-only rejection",
        "",
        "  --format json                        machine-readable output",
        "  SOCRATES_HOME                        data root (default ~/.socrates)",
        "  socrates home                          print the resolved data root",
        "",
        "  taste   add [--json '<json>']          record preference feedback (or stdin)",
        "          list [--status --level --tag]",
        "          compile                        regenerate TASTE.md",
        "          retire <id>",
        "",
        "  card    add [--json '<json>'] [--no-render]",
        "          list [--status --topic --tag]",
        "          review <id> --status known|learning|seen|retired",
        "",
        "  render  [--id <card-id>] [--mood]        rebuild html (all cards by default)",
        "",
        "  mood    add [--json '<json>'] [--no-download]",
        "          list [--status --tag --applies-to]",
        "          board                          render site/mood.html",
        "          adopt <id> | reject <id>",
        "",
        "  --format json                          machine-readable output",
        "  SOCRATES_HOME                          data root (default ~/.socrates)",
      ].join("\n"),
      false,
    );
    return;
  }

  if (group === "home") {
    out({ home: resolveHome(), paths: paths() }, true);
    return;
  }

  if (group === "capture") {
    captureEvents(flags, asJson);
    return;
  }

  if (group === "extract") {
    const result = extract(flags);
    if (asJson) out(result, true);
    else if (Array.isArray(result)) {
      out(
        result
          .map((s) =>
            [
              s.session.slice(0, 8),
              String(s.eventCount).padStart(4),
              s.hasConversation ? "     " : "none ",
              (s.endedAt ?? "").slice(0, 16),
              s.cwd,
            ].join("  "),
          )
          .join("\n"),
        false,
      );
    } else if (result.digest) out(result.digest, false);
    else out(`skipped ${result.session.slice(0, 8)}: ${result.skipped}`, false);
    return;
  }

  if (group === "moments") {
    switch (command) {
      case "add":
        out(await momentsAdd(flags), asJson);
        break;
      case "list": {
        const moments = momentsList(flags);
        if (!moments.length) noteEmpty("moments", paths(home).moments);
        out(moments, asJson);
        break;
      }
      case "dismiss":
        out(momentsDismiss(positional[0] ?? flags.id), asJson);
        break;
      default:
        fail(`unknown moments command: ${command ?? "(none)"}`);
    }
    return;
  if (group === "render") {
    const home = resolveHome();
    ensureDirs(home);
    try {
      if (flags.mood) out({ wrote: renderMoodBoardTo(home) }, asJson);
      else out(flags.id ? { wrote: renderOne(flags.id, home) } : renderAll(home), asJson);
    } catch (error) {
      fail(error.message);
    }
    return;
  }

  if (group === "mood") {
    switch (command) {
      case "add":
        out(await moodAdd(flags), asJson);
        return;
      case "list":
        out(
          listMoods(resolveHome(), {
            status: flags.status,
            tag: flags.tag,
            appliesTo: flags["applies-to"],
          }),
          asJson,
        );
        return;
      case "board":
        out(moodBoard(flags), asJson);
        return;
      case "adopt":
      case "reject": {
        const home = resolveHome();
        try {
          const status = command === "adopt" ? "adopted" : "rejected";
          const mood = setMoodStatus(positional[0] ?? flags.id, status, home);
          renderMoodBoardTo(home);
          out(mood, asJson);
        } catch (error) {
          fail(error.message);
        }
        return;
      }
      default:
        fail(`unknown mood command: ${command ?? "(none)"}`);
    }
  }

  if (group === "card") {
    switch (command) {
      case "add":
        out(await cardAdd(flags), asJson);
        return;
      case "list":
        out(cardList(flags), asJson);
        return;
      case "review": {
        const home = resolveHome();
        try {
          out(reviewCard(positional[0] ?? flags.id, positional[1] ?? flags.status, home), asJson);
        } catch (error) {
          fail(error.message);
        }
        return;
      }
      default:
        fail(`unknown card command: ${command ?? "(none)"}`);
    }
  }

  if (group !== "taste") fail(`unknown command group: ${group}`);

  switch (command) {
    case "add":
      out(await tasteAdd(flags), asJson);
      break;
    case "list":
      {
        const statements = tasteList(flags);
        if (!statements.length) noteEmpty("statements", paths(home).statements);
        out(statements, asJson);
      }
      break;
    case "compile":
      out(tasteCompile(), asJson);
      break;
    case "retire":
      out(tasteRetire(positional[0] ?? flags.id), asJson);
      break;
    default:
      fail(`unknown taste command: ${command ?? "(none)"}`);
  }
}

main().catch((error) => fail(error.stack ?? String(error)));
