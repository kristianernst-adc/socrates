#!/usr/bin/env node
// Socrates CLI — the automation surface.
//
// The skill is the interactive surface; this is what the skill, cron jobs and
// scripts actually call. Keep it boring and scriptable.

import { readFileSync } from "node:fs";
import { createInterface } from "node:readline";

import { allEvents, capture, listSessions as capturedSessions, readSession } from "../lib/capture.mjs";
import { listSessions as summarise, renderDigest } from "../lib/digest.mjs";
import { normalizeMoment } from "../lib/model.mjs";
import {
  downloadMoodAsset,
  listMoods,
  normalizeMood,
  recordMood,
  setMoodStatus,
} from "../lib/mood.mjs";
import { dismissPage, listPages, recordPage } from "../lib/page.mjs";
import { renderAll, renderMoodBoardTo, renderOne } from "../lib/render.mjs";
import {
  appendJsonl,
  ensureDirs,
  paths,
  readJsonl,
  readLatestById,
  resolveHome,
  writeAtomic,
} from "../lib/store.mjs";
import { compile, recordFeedback } from "../lib/taste.mjs";

function parseArgs(argv) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < argv.length; i += 1) {
    const token = argv[i];
    if (token.startsWith("--")) {
      const [name, inline] = token.slice(2).split("=");
      if (inline !== undefined) flags[name] = inline;
      else if (argv[i + 1] && !argv[i + 1].startsWith("--")) {
        flags[name] = argv[i + 1];
        i += 1;
      } else flags[name] = true;
    } else positional.push(token);
  }
  return { flags, positional };
}

async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8").trim();
}

function out(value, asJson) {
  if (asJson) process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
  else process.stdout.write(typeof value === "string" ? `${value}\n` : `${JSON.stringify(value, null, 2)}\n`);
}

function fail(message) {
  process.stderr.write(`socrates: ${message}\n`);
  process.exit(1);
}

function noteEmpty(what, where) {
  process.stderr.write(`socrates: no ${what} yet — expected at ${where}\n`);
}

async function readPayload(flags, what) {
  // --json-file avoids shell quoting entirely, which matters when the payload
  // contains html.
  if (typeof flags["json-file"] === "string") {
    try {
      return JSON.parse(readFileSync(flags["json-file"], "utf8"));
    } catch (error) {
      fail(`could not read ${flags["json-file"]}: ${error.message}`);
    }
  }
  const raw = typeof flags.json === "string" ? flags.json : await readStdin();
  if (!raw) fail(`${what} expects a JSON object on stdin, via --json, or via --json-file`);
  try {
    return JSON.parse(raw);
  } catch (error) {
    fail(`could not parse JSON input: ${error.message}`);
  }
}

// ---------------------------------------------------------------------------
// capture
// ---------------------------------------------------------------------------

function captureRun(flags) {
  const home = resolveHome();
  ensureDirs(home);

  // Explicit selection only. A bare `capture` syncs everything already on disk,
  // which is cheap after the first run because unchanged files are skipped.
  const files = [];
  if (typeof flags.file === "string") files.push(flags.file);
  if (flags.current) {
    const current = process.env.PI_SESSION_FILE;
    if (!current) fail("no current session here (PI_SESSION_FILE is unset)");
    files.push(current);
  }

  return capture({
    home,
    only: files.length ? files : undefined,
    adapter: typeof flags.adapter === "string" ? flags.adapter : flags.harness,
    force: Boolean(flags.force),
    dryRun: Boolean(flags["dry-run"]),
  });
}

function captureReport(result) {
  const lines = [
    `captured ${result.events} events (${result.skipped} unchanged, ${result.failed.length} failed)`,
  ];
  for (const c of result.captured.slice(0, 25)) {
    lines.push(
      `  ${c.mode === "delta" ? "append" : "full  "} ${String(c.events).padStart(5)}  ${c.adapter}/${String(
        c.session ?? "?",
      ).slice(0, 12)}`,
    );
  }
  if (result.captured.length > 25) lines.push(`  … and ${result.captured.length - 25} more`);
  for (const f of result.failed) lines.push(`  FAILED ${f.file}: ${f.error}`);
  return lines.join("\n");
}

// ---------------------------------------------------------------------------
// extract
// ---------------------------------------------------------------------------

function extract(flags) {
  const home = resolveHome();
  const events = allEvents(home);
  if (!events.length) fail("no events yet — run `socrates capture` first");

  if (flags.list === true) return summarise(events).map(({ events: _e, ...rest }) => rest);

  if (typeof flags.session === "string") {
    const path = readSession(home, flags.session);
    if (!path) fail(`no captured session matching ${flags.session}`);
    return { digest: renderDigest(path) };
  }

  const sessions = capturedSessions(home);
  if (!sessions.length) fail("nothing captured");
  const chosen = flags.latest ? sessions[0] : sessions[0];
  return { digest: renderDigest(chosen.path), session: chosen.session };
}

// ---------------------------------------------------------------------------
// moments
// ---------------------------------------------------------------------------

async function momentsAdd(flags) {
  const payload = await readPayload(flags, "moments add");

  // When the CLI is called from a Pi session (a skill shells out), the harness
  // exports these. Fill in provenance once, here, rather than trusting the caller.
  if (process.env.PI_SESSION_ID) {
    payload.origin = {
      sessionId: process.env.PI_SESSION_ID,
      harness: "pi",
      cwd: process.cwd(),
      ...payload.origin,
    };
    payload.capturedBy = { harness: "pi", model: process.env.PI_MODEL, ...payload.capturedBy };
  }
  payload.capturedBy = { by: "cli", ...payload.capturedBy };

  const home = resolveHome();
  ensureDirs(home);
  let moment;
  try {
    moment = normalizeMoment(payload);
  } catch (error) {
    fail(error.message);
  }
  appendJsonl(paths(home).moments, moment);
  return moment;
}

function momentsList(flags) {
  const home = resolveHome();
  let moments = readLatestById(paths(home).moments);
  if (flags.session) moments = moments.filter((m) => m.origin?.sessionId?.startsWith(flags.session));
  if (flags.kind) moments = moments.filter((m) => m.kind === flags.kind);
  if (flags.status) moments = moments.filter((m) => m.status === flags.status);
  return moments
    .sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)))
    .slice(0, Number(flags.limit) || 20);
}

function momentsDismiss(id) {
  if (!id) fail("moments dismiss needs a moment id");
  const home = resolveHome();
  const moment = readLatestById(paths(home).moments).find((m) => m.id === id);
  if (!moment) fail(`no moment with id ${id}`);
  const dismissed = { ...moment, status: "rejected", updatedAt: new Date().toISOString() };
  appendJsonl(paths(home).moments, dismissed);
  return dismissed;
}

// ---------------------------------------------------------------------------
// pages
// ---------------------------------------------------------------------------

async function pageAdd(flags) {
  const payload = await readPayload(flags, "page add");
  const home = resolveHome();
  ensureDirs(home);

  // Fill in what the author should never have to guess.
  const provenance = payload.provenance ?? {};
  provenance.cwd = provenance.cwd ?? process.cwd();
  if (process.env.PI_SESSION_ID) provenance.session = provenance.session ?? process.env.PI_SESSION_ID;
  if (process.env.PI_MODEL) provenance.model = provenance.model ?? process.env.PI_MODEL;
  payload.provenance = provenance;

  let page;
  try {
    page = recordPage(payload, home);
  } catch (error) {
    fail(error.message);
  }
  const file = flags["no-render"] ? undefined : renderOne(page.id, home);
  return { page, file };
}

function pageList(flags) {
  let pages = listPages(resolveHome(), { includeDismissed: Boolean(flags.all) });
  if (flags.topic) pages = pages.filter((p) => p.topic === flags.topic);
  if (flags.tag) pages = pages.filter((p) => p.tags.includes(flags.tag));
  return pages.sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1));
}

// ---------------------------------------------------------------------------
// mood
// ---------------------------------------------------------------------------

async function moodAdd(flags) {
  const payload = await readPayload(flags, "mood add");
  const home = resolveHome();
  ensureDirs(home);

  let mood;
  try {
    mood = normalizeMood(payload);
  } catch (error) {
    fail(error.message);
  }

  // Downloading is best effort: a dead link must not lose the reference.
  let download = { downloaded: false, reason: "skipped" };
  if (!flags["no-download"]) {
    download = await downloadMoodAsset(mood, home);
    mood = download.mood;
  }
  recordMood(mood, home);
  return { mood, downloaded: download.downloaded, reason: download.reason };
}

// ---------------------------------------------------------------------------
// taste
// ---------------------------------------------------------------------------

async function tasteAdd(flags) {
  const payload = await readPayload(flags, "taste add");
  if (process.env.PI_PROVIDER) payload.harness = payload.harness ?? "pi";
  const home = resolveHome();
  ensureDirs(home);
  try {
    return recordFeedback(payload, home);
  } catch (error) {
    fail(error.message);
  }
}

function tasteList(flags) {
  const home = resolveHome();
  let statements = readLatestById(paths(home).statements);
  if (flags.status) statements = statements.filter((s) => s.status === flags.status);
  if (flags.level) statements = statements.filter((s) => s.scope.level === flags.level);
  if (flags.tag) statements = statements.filter((s) => s.tags?.includes(flags.tag));
  return statements.sort((a, b) => b.confidence - a.confidence);
}

function tasteCompile() {
  const home = resolveHome();
  ensureDirs(home);
  const statements = readLatestById(paths(home).statements);
  writeAtomic(paths(home).compiled, compile(statements));
  return { wrote: paths(home).compiled, statements: statements.length };
}

function tasteRetire(id) {
  if (!id) fail("taste retire needs a statement id");
  const home = resolveHome();
  const statement = readLatestById(paths(home).statements).find((s) => s.id === id);
  if (!statement) fail(`no statement with id ${id}`);
  const retired = { ...statement, status: "retired", updatedAt: new Date().toISOString() };
  appendJsonl(paths(home).statements, retired);
  return retired;
}

// ---------------------------------------------------------------------------

const HELP = [
  "socrates — learn from the work you already did",
  "",
  "  capture [--current] [--file <path>] [--adapter <a>] [--force] [--dry-run]",
  "          sync transcripts into events (unchanged files are skipped)",
  "  extract [--list | --session <id>]",
  "          a readable digest of a captured session",
  "",
  "  moments add [--json-file <p>] | list [--kind --status --limit] | dismiss <id>",
  "  page    add [--json-file <p>] [--no-render] | list [--topic --tag] [--all]",
  "          dismiss <id>",
  "",
  "  render  [--id <page-id>] [--mood]     rebuild html",
  "  mood    add [--json-file <p>] [--no-download] | list | board | adopt <id> | reject <id>",
  "  taste   add [--json-file <p>] | list | compile | retire <id>",
  "",
  "  home                                  print the data root",
  "",
  "  --format json                         machine-readable output",
  "  SOCRATES_HOME                         data root (default ~/.socrates)",
].join("\n");

async function main() {
  // Parse the whole argv so flags can appear before, between or after the
  // positional words.
  const parsed = parseArgs(process.argv.slice(2));
  const [group, command, ...positional] = parsed.positional;
  const flags = parsed.flags;
  const asJson = flags.format === "json" || process.env.SOCRATES_FORMAT === "json";
  const home = () => resolveHome();

  if (!group || group === "help" || flags.help) {
    out(HELP, false);
    return;
  }

  switch (group) {
    case "home":
      out({ home: home(), paths: paths(home()) }, true);
      return;

    case "capture": {
      const result = captureRun(flags);
      out(asJson ? result : captureReport(result), asJson);
      return;
    }

    case "extract": {
      const result = extract(flags);
      if (asJson) out(result, true);
      else if (Array.isArray(result)) {
        out(
          result
            .map((s) =>
              [
                String(s.session ?? "?").slice(0, 8),
                String(s.eventCount ?? 0).padStart(4),
                s.hasConversation ? "     " : "none ",
                String(s.endedAt ?? "").slice(0, 16),
                s.cwd ?? "",
              ].join("  "),
            )
            .join("\n"),
          false,
        );
      } else out(result.digest, false);
      return;
    }

    case "moments":
      switch (command) {
        case "add":
          out(await momentsAdd(flags), asJson);
          return;
        case "list": {
          const moments = momentsList(flags);
          if (!moments.length) noteEmpty("moments", paths(home()).moments);
          out(moments, asJson);
          return;
        }
        case "dismiss":
          out(momentsDismiss(positional[0] ?? flags.id), asJson);
          return;
        default:
          fail(`unknown moments command: ${command ?? "(none)"}`);
      }
      return;

    case "page":
      switch (command) {
        case "add":
          out(await pageAdd(flags), asJson);
          return;
        case "list":
          out(pageList(flags), asJson);
          return;
        case "dismiss": {
          const id = positional[0] ?? flags.id;
          if (!id) fail("page dismiss needs an id");
          out(dismissPage(id, home()), asJson);
          return;
        }
        default:
          fail(`unknown page command: ${command ?? "(none)"}`);
      }
      return;

    case "render": {
      const h = home();
      ensureDirs(h);
      try {
        if (flags.mood) out({ wrote: renderMoodBoardTo(h) }, asJson);
        else if (typeof flags.id === "string") out({ wrote: renderOne(flags.id, h) }, asJson);
        else out(renderAll(h), asJson);
      } catch (error) {
        fail(error.message);
      }
      return;
    }

    case "mood":
      switch (command) {
        case "add":
          out(await moodAdd(flags), asJson);
          return;
        case "list":
          out(
            listMoods(home(), {
              status: flags.status,
              tag: flags.tag,
              appliesTo: flags["applies-to"],
            }),
            asJson,
          );
          return;
        case "board":
          out({ wrote: renderMoodBoardTo(home()), items: listMoods(home()).length }, asJson);
          return;
        case "adopt":
        case "reject": {
          const id = positional[0] ?? flags.id;
          try {
            out(setMoodStatus(id, command === "adopt" ? "adopted" : "rejected", home()), asJson);
            renderMoodBoardTo(home());
          } catch (error) {
            fail(error.message);
          }
          return;
        }
        default:
          fail(`unknown mood command: ${command ?? "(none)"}`);
      }
      return;

    case "taste":
      switch (command) {
        case "add":
          out(await tasteAdd(flags), asJson);
          return;
        case "list":
          out(tasteList(flags), asJson);
          return;
        case "compile":
          out(tasteCompile(), asJson);
          return;
        case "retire":
          out(tasteRetire(positional[0] ?? flags.id), asJson);
          return;
        default:
          fail(`unknown taste command: ${command ?? "(none)"}`);
      }
      return;

    default:
      fail(`unknown command group: ${group}`);
  }
}

main().catch((error) => fail(error.stack ?? String(error)));
